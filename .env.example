# Copy this file to .env and fill in your own values.
# Anything left empty falls back to the default shown in brackets.

# ---------- Appium server ----------
# [127.0.0.1]
APPIUM_HOST=127.0.0.1
# [4723]
APPIUM_PORT=4723

# ---------- Android ----------
# Device id from `adb devices`  [emulator-5554]
ANDROID_UDID=emulator-5554
# Any label, shown in the report  [Android Device]
ANDROID_DEVICE_NAME=Android Device
# Optional, e.g. 15  (from `adb shell getprop ro.build.version.release`)
ANDROID_PLATFORM_VERSION=
# APK file name inside apps/, or an absolute path  [app-staging-debug.apk]
ANDROID_APP=app-staging-debug.apk
# Optional - leave EMPTY. Appium reads the package from the APK itself.
# Only set it to override; it must then match the package INSIDE the APK
# (the file name / flavor doesn't matter). Check with:
#   $ANDROID_HOME/build-tools/<version>/aapt2 dump badging apps/<file>.apk | grep package
ANDROID_APP_PACKAGE=

# ---------- iOS (real registered iPhone only) ----------
# Name from `xcrun devicectl list devices`  [My iPhone]
IOS_DEVICE_NAME=My iPhone
# Your iPhone's UDID (required)
IOS_UDID=00000000-0000000000000000
# iOS version on the phone, e.g. 18.0
IOS_PLATFORM_VERSION=18.0
# Apple Team ID that signs WebDriverAgent (required)
IOS_XCODE_ORG_ID=YOUR_TEAM_ID
# [Apple Development]
IOS_XCODE_SIGNING_ID=Apple Development
# IPA file name inside apps/, or an absolute path  [Zippiee Driver Staging.ipa]
IOS_APP=Zippiee Driver Staging.ipa
# [com.zippieedriver.ios]
IOS_BUNDLE_ID=com.zippieedriver.ios

# ---------- Test account (staging) ----------
# Approved staging driver with a FIXED OTP, so login lands on the dashboard.
# Number WITHOUT the dial code, as typed on the sign-in screen.
TEST_PHONE_NUMBER=
# The fixed OTP for that number (4 digits)
TEST_OTP=

# Suspended driver test account (to check if account is blocked or reinstated)
TEST_SUSPENDED_PHONE_NUMBER=8051515151
TEST_SUSPENDED_OTP=1234
# Optional: a wrong 4-digit OTP for the negative case (empty = case skipped)
TEST_WRONG_OTP=
# Optional: country picked on sign-in  [NG / Nigeria / +234]
TEST_COUNTRY_ISO=NG
TEST_COUNTRY_NAME=Nigeria
TEST_DIAL_CODE=+234
# Optional: a number that is too short  [123]
TEST_INVALID_PHONE=123
