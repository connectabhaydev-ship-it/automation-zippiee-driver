# Copy this file to .env and fill in your own values.
# Anything left empty falls back to the default shown in brackets.

# ---------- Appium server ----------
# [127.0.0.1]
APPIUM_HOST=127.0.0.1
# [4723]
APPIUM_PORT=4723

# ---------- Android ----------
# Device id from `adb devices`  [emulator-5554]
ANDROID_UDID=emulator-5554
# Any label, shown in the report  [Android Device]
ANDROID_DEVICE_NAME=Android Device
# Optional, e.g. 15  (from `adb shell getprop ro.build.version.release`)
ANDROID_PLATFORM_VERSION=
# APK file name inside apps/, or an absolute path  [app-staging-debug.apk]
ANDROID_APP=app-staging-debug.apk
# Optional - leave EMPTY. Appium reads the package from the APK itself.
# Only set it to override; it must then match the package INSIDE the APK
# (the file name / flavor doesn't matter). Check with:
#   $ANDROID_HOME/build-tools/<version>/aapt2 dump badging apps/<file>.apk | grep package
ANDROID_APP_PACKAGE=

# ---------- iOS (real registered iPhone only) ----------
# Name from `xcrun devicectl list devices`  [My iPhone]
IOS_DEVICE_NAME=My iPhone
# Your iPhone's UDID (required)
IOS_UDID=00000000-0000000000000000
# iOS version on the phone, e.g. 18.0
IOS_PLATFORM_VERSION=18.0
# Apple Team ID that signs WebDriverAgent (required)
IOS_XCODE_ORG_ID=YOUR_TEAM_ID
# [Apple Development]
IOS_XCODE_SIGNING_ID=Apple Development
# IPA file name inside apps/, or an absolute path  [Zippiee Driver Staging.ipa]
IOS_APP=Zippiee Driver Staging.ipa
# [com.zippieedriver.ios]
IOS_BUNDLE_ID=com.zippieedriver.ios

# ---------- Test account (staging) ----------
# Approved staging driver with a FIXED OTP, so login lands on the dashboard.
# Number WITHOUT the dial code, as typed on the sign-in screen.
TEST_PHONE_NUMBER=
# The fixed OTP for that number (4 digits)
TEST_OTP=
# Optional: a wrong 4-digit OTP for the negative case (empty = case skipped)
TEST_WRONG_OTP=
# Optional: country picked on sign-in  [NG / Nigeria / +234]
TEST_COUNTRY_ISO=NG
TEST_COUNTRY_NAME=Nigeria
TEST_DIAL_CODE=+234
# Optional: a number that is too short  [123]
TEST_INVALID_PHONE=123

# ---------- Order lifecycle (10-order-flow) ----------
# Spec 10 runs BOTH apps on the same phone: driver goes ONLINE, the customer app
# places a Cash-on-Delivery order, the driver accepts and delivers it.
# In the Restaurant Partner panel: accept the order (New Orders) and mark it
# Ready when the console asks.
# Customer staging app package; must be installed AND logged in  [dev.zippiee.android]
CUSTOMER_APP_PACKAGE=dev.zippiee.android
# Restaurant to order from, exactly as shown in the customer app, e.g. The Crown & Castle.
# MUST be the restaurant logged in to the Restaurant Partner panel
# (http://169.58.34.182:9002/live-orders), which accepts the order (New Orders)
# and marks it Ready. Empty = first restaurant in the customer list.
CUSTOMER_RESTAURANT=
# Customer delivery code. Empty = read "Your PIN" from the customer app.
TEST_DELIVERY_CODE=
# Wrong code for the negative case; must differ from the real one  [9999]
TEST_WRONG_DELIVERY_CODE=9999
# Seconds to wait for an offer after going online  [120]
ORDER_OFFER_TIMEOUT_SEC=120
# Seconds to wait for the restaurant to mark the order ready  [600]
ORDER_READY_TIMEOUT_SEC=600
# Seconds to wait for a manual step on the phone  [300]
ORDER_MANUAL_STEP_TIMEOUT_SEC=300

# ---------- Sign-up / account status (16-sign-up-status) ----------
# Optional: a BLOCKED staging driver number (no dial code). Empty = TC83 skipped.
TEST_BLOCKED_PHONE=
# Set to 1 to reinstall the app and wipe the saved login (runs specs 01-02 too).
FRESH_INSTALL=0

# ---------- Bank account (added automatically when the driver has none) ----------
# Must be a REAL account: staging checks it with the bank before saving.
# Bank code = the dropdown option key (common_dropdown_option_<code>), e.g. 044 = Access Bank
TEST_BANK_CODE=044
TEST_BANK_SEARCH=Access Bank
TEST_BANK_ACCOUNT_NO=
TEST_BANK_ACCOUNT_NAME=
